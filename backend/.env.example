# Copy to backend/.env.local (git-ignored). Used only by the backend test scripts.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # or the legacy "anon" key

# Two throwaway accounts for `npm run test:rls-live` (created automatically if sign-up is open)
RLS_TEST_A_EMAIL=
RLS_TEST_A_PASSWORD=
RLS_TEST_B_EMAIL=
RLS_TEST_B_PASSWORD=

# Server-side only. Never prefix with VITE_, never import in frontend/src.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
