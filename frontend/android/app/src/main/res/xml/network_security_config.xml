<?xml version="1.0" encoding="utf-8"?>
<!--
  FLOVA Android Network Security Configuration (SEC-09)
  Enforces HTTPS system-wide, disallows cleartext traffic,
  and restricts trusted anchors to system CAs.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
