# Copy to frontend/.env.local (git-ignored). Supabase -> Project Settings -> API.
# Everything starting with VITE_ is visible in the browser: only browser-safe values here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # or the legacy "anon" key
# Never put the service-role key or GEMINI_API_KEY in a VITE_ variable.
