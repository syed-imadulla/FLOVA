# Copy to frontend/.env.local (git-ignored). Supabase -> Project Settings -> API.
# Everything starting with VITE_ is visible in the browser: only browser-safe values here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # Supabase publishable key
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...              # or legacy anon JWT key

# Google Web Client ID for Google Sign-In (Credential Manager on Android / OAuth)
VITE_GOOGLE_WEB_CLIENT_ID=YOUR-GOOGLE-WEB-CLIENT-ID.apps.googleusercontent.com

# SECURITY RULE: Never put the service-role key, database password, or Groq API key in any VITE_ variable.
