{
  "name": "FLOVA — Make your money move smarter",
  "short_name": "FLOVA",
  "description": "Financial runway planner and smart money manager for Indian gig delivery partners and independent workers.",
  "start_url": "/app",
  "display": "standalone",
  "background_color": "#FAF7F2",
  "theme_color": "#0F5C4C",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*",
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        }
      ]
    }
  },
  "id": "/app",
  "scope": "/"
}
